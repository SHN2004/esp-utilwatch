(text "UtilWatch board" (exclude_from_sim no) (at 25.4 22.86 0) (effects (font (size 2.54 2.54)) (justify left top)) (uuid "b1130867-5a77-492a-8b12-e535f284a016"))
(text "Factory-assembled (JLCPCB parts, LCSC numbers in each part's LCSC field). You solder the OLED and the battery leads.\nSame GPIOs as the breadboard build: buttons IO4-7 to GND, OLED SDA IO19 / SCL IO20. Flash over USB-C (IO12/IO13)." (exclude_from_sim no) (at 25.4 30.48 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "58741c02-1899-4036-a44e-153868445924"))
(text "Power:\n- USB plugged in: D1 feeds VSYS and Q1 is off, so the charger only charges the battery.\n- Unplugged: Q1 connects the battery to VSYS.\n- SW1 switches the 3.3 V regulator. Charging works with SW1 off; the watch (and USB flashing) needs SW1 on.\n- Use a LiPo with its own protection board (most hobby cells have one). Battery red lead to J2 pin 1 (+)." (exclude_from_sim no) (at 25.4 210.82 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "c7cd14ec-af0e-41e1-9c87-e77ae66fd43e"))
  (sheet_instances (path "/" (page "1")))
  (embedded_fonts no)
)
